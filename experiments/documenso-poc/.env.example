# Modèle de configuration du POC Documenso. AUCUNE VALEUR RÉELLE ICI.
#
# Ne pas remplir ce fichier à la main : lancer les scripts, qui génèrent
# .env avec des valeurs cryptographiquement sûres.
#
#   ./scripts/00-generate-secrets.sh      -> les 4 secrets ci-dessous
#   ./scripts/01-generate-certificate.sh  -> la passphrase du certificat
#
# .env est couvert par le .gitignore de ce dossier.

# Mot de passe PostgreSQL du POC. openssl rand.
POSTGRES_PASSWORD=

# Secret de session. openssl rand.
NEXTAUTH_SECRET=

# Clé de chiffrement applicative. openssl rand.
# ATTENTION : la régénérer rend illisibles les données déjà chiffrées en base.
NEXT_PRIVATE_ENCRYPTION_KEY=

# Clé de chiffrement secondaire. openssl rand.
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# Passphrase de l'archive PKCS#12 de signature.
# Écrite par 01-generate-certificate.sh.
NEXT_PRIVATE_SIGNING_PASSPHRASE=
